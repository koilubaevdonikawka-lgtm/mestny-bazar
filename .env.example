# App environment (public)
VITE_APP_URL=https://your-app.example.com
APP_URL=https://your-app.example.com
APP_NAME=Местный Базар

# Supabase
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REQUIRED — the app fails to
# start without them (see server/config/env.ts). SUPABASE_SERVICE_ROLE_KEY
# backs every server-side repository (orders, addresses, seller products,
# audit log, ...) regardless of any feature flag below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Finik online payment (Промпт №077 — RSA key pair per official Finik docs,
# supersedes the Промпт №075 HMAC-secret placeholder). All optional. Without
# them, checkout still works (cash unaffected; online payment reports itself
# unavailable instead of crashing — see
# server/adapters/payment/payment-provider.factory.ts).
# FINIK_RSA_PRIVATE_KEY: our RSA private key (PKCS8 PEM) — signs every
# outgoing request (SHA256withRSA). Store the PEM with literal `\n` for
# newlines in a single-line env var (standard convention for multi-line
# secrets in .env files).
# FINIK_WEBHOOK_PUBLIC_KEY: Finik's RSA public key (SPKI PEM) — verifies
# incoming webhook signatures. NOT the same key as FINIK_RSA_PRIVATE_KEY.
# FINIK_ENVIRONMENT: "beta" or "production" — selects the official endpoint
# (see server/adapters/payment/finik.adapter.ts).
FINIK_API_KEY=
FINIK_RSA_PRIVATE_KEY=
FINIK_WEBHOOK_PUBLIC_KEY=
FINIK_MERCHANT_ID=
FINIK_ENVIRONMENT=

# Notifications (Stage 8 — not yet wired to a real provider, see
# server/adapters/notifications/stub-notification.adapter.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WAREHOUSE_CHAT_ID=
TELEGRAM_COURIER_CHAT_ID=
WHATSAPP_API_TOKEN=

# AI (Промпт №088/089) — universal, provider-agnostic AI text-translation
# infrastructure. GOOGLE_AI_API_KEY: Google AI (Gemini API / AI Studio) key.
# Falls back to a safe stub when absent — server/adapters/ai/stub-ai-provider.ts.
GOOGLE_AI_API_KEY=
