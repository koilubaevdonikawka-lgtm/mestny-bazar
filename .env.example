# App environment (public)
VITE_APP_URL=https://your-app.lovable.app
APP_URL=https://your-app.lovable.app
APP_NAME=Местный Базар

# Supabase (from Lovable Cloud)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REQUIRED — the app fails to
# start without them (see server/config/env.ts). SUPABASE_SERVICE_ROLE_KEY
# backs every server-side repository (orders, addresses, seller products,
# audit log, ...) regardless of any feature flag below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Feature flags
# checkoutSource must track catalogSource — CheckoutService resolves every
# line item against the Supabase products table only, never Shopify (see
# src/config/features.ts and server/di/container.ts). Only set both to
# "platform" once the platform catalog (Stage 3) is actually live; until
# then this pair must stay "shopify" + "shopify".
FEATURE_CATALOG_SOURCE=shopify
VITE_FEATURE_CATALOG_SOURCE=shopify
FEATURE_CHECKOUT_SOURCE=shopify
VITE_FEATURE_CHECKOUT_SOURCE=shopify

# Shopify (server-only, temporary during migration)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# Finik (Stage 7)
FINIK_API_KEY=
FINIK_WEBHOOK_SECRET=

# Notifications (Stage 8 — not yet wired to a real provider, see
# server/adapters/notifications/stub-notification.adapter.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WAREHOUSE_CHAT_ID=
TELEGRAM_COURIER_CHAT_ID=
WHATSAPP_API_TOKEN=
