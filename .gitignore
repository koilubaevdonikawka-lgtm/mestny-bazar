# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# vitest --coverage report output
coverage

# Environment files — real config/secrets, never commit. .env.example is a
# template with no real values and must stay tracked.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Claude Code local/session state — machine-specific tool permissions and
# runtime lock files, never shared. The existing *.local pattern above only
# matches names ending in ".local" (e.g. foo.local), not "settings.local.json"
# (.local as a middle segment), so it didn't catch this.
.claude/settings.local.json
.claude/*.lock

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ad-hoc command output redirected to a file during local debugging — never
# meant to be committed (analysis.md already flagged tsc-output.txt /
# tsc-analytics.txt as exactly this, accidentally committed in the baseline).
tsc-output.txt
tsc-analytics.txt
