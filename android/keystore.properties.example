# Copy this file to `keystore.properties` (same directory) and fill in real
# values before running a signed release build. `keystore.properties` is
# gitignored — never commit real passwords or the .jks/.keystore file itself.
#
# Generate a release keystore (one-time, keep it safe — losing it means you
# can never update the app under the same Play Store listing again):
#   keytool -genkey -v -keystore mestny-bazar-release.keystore -alias mestny-bazar -keyalg RSA -keysize 2048 -validity 10000

storeFile=/absolute/path/to/mestny-bazar-release.keystore
storePassword=CHANGE_ME
keyAlias=mestny-bazar
keyPassword=CHANGE_ME
